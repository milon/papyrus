# Normalize text files
* text=auto eol=lf

*.md text eol=lf
*.php text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.css text eol=lf
*.js text eol=lf
*.html text eol=lf
*.sh text eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.pdf binary
*.epub binary

# Keep Packagist / composer archive lean (stubs stay — they are the default assets)
/.github/ export-ignore
/docs/ export-ignore
/tests/ export-ignore
/scripts/ export-ignore
/phpunit.xml.dist export-ignore
/pint.json export-ignore
/.editorconfig export-ignore
/.gitattributes export-ignore
/.gitignore export-ignore
