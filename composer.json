{
    "name": "milon/papyrus",
    "description": "PHP CLI for Markdown book projects — PDF, EPUB, HTML, multi-page site, and Amazon KDP exports",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "markdown",
        "book",
        "pdf",
        "epub",
        "html",
        "static-site",
        "kdp",
        "kindle",
        "publishing",
        "cli"
    ],
    "homepage": "https://papyrus.milon.im/",
    "support": {
        "docs": "https://papyrus.milon.im/",
        "issues": "https://github.com/milon/papyrus/issues",
        "source": "https://github.com/milon/papyrus"
    },
    "authors": [
        {
            "name": "Nuruzzaman Milon",
            "homepage": "https://milon.im"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-dom": "*",
        "ext-gd": "*",
        "ext-mbstring": "*",
        "ext-zip": "*",
        "ext-zlib": "*",
        "league/commonmark": "^2.7",
        "mpdf/mpdf": "^8.2",
        "spatie/commonmark-highlighter": "^3.0",
        "symfony/console": "^7.2",
        "symfony/yaml": "^7.2",
        "hi-folks/phpepub": "^1.0"
    },
    "require-dev": {
        "laravel/pint": "^1.21",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Milon\\Papyrus\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Milon\\Papyrus\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/papyrus"
    ],
    "scripts": {
        "test": "phpunit",
        "lint": "pint --test",
        "format": "pint",
        "build:handbook": "bash scripts/build-handbook.sh"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
